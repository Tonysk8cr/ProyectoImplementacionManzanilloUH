@model Propietario
@{
    ViewData["Title"] = $"Detalle de {Model.NombreCompleto}";
}

<div class="page-header">
    <div>
        <h1>@Model.NombreCompleto</h1>
        <p class="lead">Datos del propietario.</p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn" asp-action="Index">Volver a la lista</a>
    </div>
</div>

<section class="card">
    <h2 class="card-title">Datos del propietario</h2>
    <dl class="detail-list">
        <div>
            <dt>Identificación</dt>
            <dd>@Model.Identificacion</dd>
        </div>
        <div>
            <dt>Correo electrónico</dt>
            <dd>@Model.Correo</dd>
        </div>
        <div>
            <dt>Teléfono</dt>
            <dd>@Model.Telefono</dd>
        </div>
        <div>
            <dt>Dirección</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</dd>
        </div>
        <div>
            <dt>Registrado el</dt>
            <dd>@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
        </div>
    </dl>
</section>
