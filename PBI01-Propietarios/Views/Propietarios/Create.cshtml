@model Propietario
@{
    ViewData["Title"] = "Registrar propietario";
}

<div class="form-card">
    <h1>Registrar propietario</h1>
    <p class="lead">Completa los datos básicos para identificar al propietario.</p>

    <form asp-action="Create" method="post" novalidate>
        <partial name="_Formulario" model="Model" />
        <button type="submit" class="btn btn-primary btn-block">Guardar propietario</button>
    </form>

    <p class="lead" style="margin-top:1rem; text-align:center;">
        <a asp-action="Index">Volver a la lista</a>
    </p>
</div>
