@model IReadOnlyList<Propietario>
@{
    ViewData["Title"] = "Propietarios";
}

<div class="page-header">
    <div>
        <h1>Propietarios</h1>
        <p class="lead">Propietarios de mascotas registrados.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Registrar propietario</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>Todavía no hay propietarios registrados.</p>
        <a class="btn btn-primary" asp-action="Create">Registrar el primer propietario</a>
    </div>
}
else
{
    <div class="grid">
        @foreach (var p in Model)
        {
            <div class="card">
                <h2 class="card-title">@p.NombreCompleto</h2>
                <p class="card-subtitle">@p.Identificacion · @p.Telefono</p>
                <p class="card-subtitle">@p.Correo</p>
                <a class="btn btn-primary" asp-action="Details" asp-route-id="@p.Id">Ver</a>
                <a class="btn" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                <a class="btn" asp-action="Delete" asp-route-id="@p.Id" style="color:var(--danger);">Eliminar</a>
            </div>
        }
    </div>
}
