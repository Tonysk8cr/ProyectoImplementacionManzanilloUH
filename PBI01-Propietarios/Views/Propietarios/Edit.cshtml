@model Propietario
@{
    ViewData["Title"] = "Editar propietario";
}

<div class="form-card">
    <h1>Editar propietario</h1>
    <p class="lead">Actualiza los datos del propietario.</p>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <partial name="_Formulario" model="Model" />
        <button type="submit" class="btn btn-primary btn-block">Guardar cambios</button>
    </form>

    <p class="lead" style="margin-top:1rem; text-align:center;">
        <a asp-action="Index">Cancelar</a>
    </p>
</div>
