<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma Veterinaria</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar container">
            <a class="brand" asp-controller="Propietarios" asp-action="Index">🐾 VetPlatform</a>
            <div class="nav-links">
                <a asp-controller="Propietarios" asp-action="Index">Propietarios</a>
                <a asp-controller="Propietarios" asp-action="Create" class="btn btn-primary">Registrar propietario</a>
            </div>
        </nav>
    </header>

    <main class="container main-content">
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            Plataforma Centralizada de Servicios Veterinarios · INFO-117 · Sprint 1 · PBI-01 (demo sin base de datos)
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
