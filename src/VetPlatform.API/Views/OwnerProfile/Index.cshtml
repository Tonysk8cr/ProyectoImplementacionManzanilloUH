@model VetPlatform.Application.Features.Owners.OwnerProfileDto?
@{
    ViewData["Title"] = "Mi perfil";
}

<div class="page-header">
    <div>
        <h1>Mi perfil de propietario</h1>
        <p class="lead">Datos con los que te identificas dentro de la plataforma.</p>
    </div>
    @if (Model is not null)
    {
        <div>
            <a class="btn btn-primary" asp-action="Edit">Editar</a>
            <a class="btn" asp-action="Delete" style="color:var(--danger);">Eliminar</a>
        </div>
    }
</div>

<div asp-validation-summary="All" class="validation-summary"></div>

@if (Model is not null)
{
    <section class="card">
        <h2 class="card-title">Datos del propietario</h2>
        <dl class="detail-list">
            <div>
                <dt>Nombre completo</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>Correo electrónico</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>Identificación</dt>
                <dd>@Model.IdentificationNumber</dd>
            </div>
            <div>
                <dt>Teléfono</dt>
                <dd>@Model.Phone</dd>
            </div>
            <div>
                <dt>Dirección</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</dd>
            </div>
            <div>
                <dt>Registrado el</dt>
                <dd>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
            </div>
        </dl>
    </section>
}
