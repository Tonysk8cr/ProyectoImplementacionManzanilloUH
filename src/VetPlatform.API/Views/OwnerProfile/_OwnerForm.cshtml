@model VetPlatform.API.ViewModels.OwnerProfileViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<div class="form-group">
    <label asp-for="IdentificationNumber"></label>
    <input asp-for="IdentificationNumber" autocomplete="off" />
    <span asp-validation-for="IdentificationNumber" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="Phone"></label>
    <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="Ej.: 8888 8888" />
    <span asp-validation-for="Phone" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="Address"></label>
    <input asp-for="Address" autocomplete="street-address" />
    <span asp-validation-for="Address" class="field-validation-error"></span>
</div>
