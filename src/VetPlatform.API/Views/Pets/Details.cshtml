@model VetPlatform.API.ViewModels.PetDetailsViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = $"Detalle de {Model.Pet.Name}";
    var pet = Model.Pet;
    var history = Model.History;
    var isOwner = User.FindFirstValue(ClaimTypes.NameIdentifier) == pet.OwnerId.ToString();
    var edad = "—";
    if (pet.BirthDate is DateOnly nacimiento)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var anios = hoy.Year - nacimiento.Year;
        if (nacimiento > hoy.AddYears(-anios)) anios--;
        edad = $"{anios} año(s)";
    }
}

<div class="page-header">
    <div>
        <h1>@pet.Name</h1>
        <p class="lead">Ficha de la mascota e historial clínico.</p>
    </div>
    @if (isOwner)
    {
        <a class="btn" asp-action="Index">Volver a mis mascotas</a>
    }
    else
    {
        <a class="btn" asp-action="Patients">Volver a mis pacientes</a>
    }
</div>

<section class="card">
    <h2 class="card-title">Datos de la mascota</h2>
    <dl class="detail-list">
        <div>
            <dt>Especie</dt>
            <dd>@pet.Species</dd>
        </div>
        <div>
            <dt>Raza</dt>
            <dd>@(string.IsNullOrWhiteSpace(pet.Breed) ? "—" : pet.Breed)</dd>
        </div>
        <div>
            <dt>Fecha de nacimiento</dt>
            <dd>@(pet.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</dd>
        </div>
        <div>
            <dt>Edad</dt>
            <dd>@edad</dd>
        </div>
        <div>
            <dt>Código QR</dt>
            <dd>@pet.QrCode</dd>
        </div>
        <div>
            <dt>Registrada el</dt>
            <dd>@pet.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
        </div>
    </dl>
</section>

<section>
    <h2>Historial clínico de @pet.Name</h2>

    @if (history is null || (history.Consultations.Count == 0 && history.EmergencyAttendances.Count == 0))
    {
        <div class="empty-state">
            <p>Todavía no hay atenciones registradas para esta mascota.</p>
        </div>
    }
    else
    {
        @if (history.Consultations.Count > 0)
        {
            <h3>Consultas (@history.Consultations.Count)</h3>
            <p class="card-subtitle">Ordenadas de la más reciente a la más antigua.</p>

            @* El servicio entrega el orden cronológico (fecha de atención y, ante empate, fecha de registro). *@
            @foreach (var consultation in history.Consultations)
            {
                var fecha = consultation.AttendanceDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
                var notas = consultation.Notes ?? "";
                <article class="consultation">
                    <div class="consultation-header">
                        <strong>Consulta · <time datetime="@consultation.AttendanceDate.ToString("o")">@fecha</time></strong>
                        <span class="badge">@consultation.Status</span>
                    </div>

                    <p class="card-subtitle">Fuente: @consultation.SourceType</p>

                    <p class="consultation-preview">
                        @(string.IsNullOrWhiteSpace(notas) ? "Sin notas registradas." : notas.Length > 160 ? notas[..160] + "…" : notas)
                    </p>

                    <div class="consultation-actions">
                        <span class="card-subtitle">
                            @consultation.Prescriptions.Count prescripción(es) · @consultation.Addenda.Count adenda(s)
                        </span>
                        <a class="btn btn-primary" asp-action="Consultation" asp-route-id="@pet.Id" asp-route-consultationId="@consultation.Id"
                           aria-label="Ver detalle de la consulta del @fecha">Ver detalle</a>
                    </div>
                </article>
            }
        }

        @if (history.EmergencyAttendances.Count > 0)
        {
            <h3>Atenciones de emergencia</h3>

            @foreach (var emergency in history.EmergencyAttendances.OrderByDescending(e => e.AttendanceDate))
            {
                <article class="consultation">
                    <div class="consultation-header">
                        <strong>Emergencia · @emergency.AttendanceDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>

                    <p><strong>Hallazgos:</strong> @emergency.Findings</p>
                    <p><strong>Acciones:</strong> @emergency.Actions</p>

                    @if (!string.IsNullOrWhiteSpace(emergency.Instructions))
                    {
                        <p><strong>Indicaciones:</strong> @emergency.Instructions</p>
                    }
                </article>
            }
        }
    }
</section>