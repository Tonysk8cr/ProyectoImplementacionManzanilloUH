@model VetPlatform.API.ViewModels.PetViewModel
@{
    ViewData["Title"] = "Registrar mascota";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="form-card">
    <h1>Registrar mascota</h1>
    <p class="lead">Completa la ficha básica. La asociación con tu perfil se hace automáticamente.</p>

    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Species"></label>
            <select asp-for="Species">
                <option value="">Selecciona una especie</option>
                <option value="Perro">Perro</option>
                <option value="Gato">Gato</option>
                <option value="Conejo">Conejo</option>
                <option value="Ave">Ave</option>
                <option value="Roedor">Roedor</option>
                <option value="Reptil">Reptil</option>
                <option value="Otro">Otro</option>
            </select>
            <span asp-validation-for="Species" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Breed"></label>
            <input asp-for="Breed" placeholder="Ej.: Labrador, Siamés. Si elegiste «Otro», indica cuál." />
            <span asp-validation-for="Breed" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="BirthDate"></label>
            <input asp-for="BirthDate" type="date" max="@hoy" />
            <span asp-validation-for="BirthDate" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Guardar mascota</button>
    </form>

    <p class="lead" style="margin-top:1rem; text-align:center;">
        <a asp-action="Index">Volver a mis mascotas</a>
    </p>
</div>