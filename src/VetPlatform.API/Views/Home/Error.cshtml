@model VetPlatform.API.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card" style="max-width:640px; margin:0 auto; text-align:center;">
    <h1>Ha ocurrido un error</h1>
    <p class="lead">Ocurrió un problema al procesar tu solicitud. Intenta de nuevo o vuelve al inicio.</p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="lead" style="font-size:0.85rem;">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
